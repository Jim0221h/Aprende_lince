<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #0f1f18;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.itc.healthtrack.controllers.DashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="8" styleClass="panel-secundario" style="-fx-border-width: 0 0 1 0;">
            <padding><Insets left="20.0" right="20.0" /></padding>
            <FontIcon iconColor="#faf8da" iconLiteral="fas-paw" iconSize="36" />
            <Label text="AprendeLince" textFill="#faf8da" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            <Label fx:id="roleLabel" textFill="#aaaaaa" style="-fx-font-size: 13px;"/>
            <Label fx:id="userNameLabel" textFill="WHITE" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <left>
        <VBox prefWidth="200.0" spacing="10.0" styleClass="panel-secundario" style="-fx-border-width: 0 1 0 0;">
            <padding><Insets bottom="20.0" left="10.0" right="10.0" top="20.0" /></padding>
            <VBox fx:id="menuBox" spacing="10.0" VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#onLogout" styleClass="btn, btn-danger" text="Cerrar Sesión" />
        </VBox>
    </left>
    <center>
        <VBox fx:id="contentArea" alignment="CENTER" />
    </center>
</BorderPane>
