<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    Layout horizontal de pantalla completa:
      [ Panel izquierdo — decorativo, fill ]  |  [ Panel derecho — formulario, 420px ]

    El panel derecho alterna internamente entre:
      · studentForm  (visible por defecto)
      · tutorPanel   (reemplaza al anterior al hacer clic en "¿Eres tutor?")
-->
<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.itc.healthtrack.controllers.LoginController">

    <!-- ════════════════════════════════════════════════════════
         PANEL IZQUIERDO — decorativo (se expande para llenar)
         ════════════════════════════════════════════════════════ -->
    <VBox alignment="CENTER" spacing="28.0" HBox.hgrow="ALWAYS"
          styleClass="login-left" style="-fx-background-color: #1a4130;
                 -fx-padding: 60 64 60 64;">

        <StackPane alignment="CENTER" prefWidth="150.0" prefHeight="150.0">
            <FontIcon iconColor="#faf8da" iconLiteral="fas-paw" iconSize="150"/>
        </StackPane>

        <VBox alignment="CENTER" spacing="8.0">
            <Label text="AprendeLince" textFill="WHITE"
                   style="-fx-font-size: 36px; -fx-font-weight: bold;"/>
            <Label text="Tutorías · TecNM Celaya" textFill="#42a5f5"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label text="AprendeLince, siempre aquí" textFill="#1a3a5c"
                   style="-fx-font-size: 12px;"/>
        </VBox>

        <!-- Línea decorativa centrada -->
        <Region prefWidth="72.0" prefHeight="1.5"
                style="-fx-background-color: rgba(33,150,243,0.28);"/>

        <!-- Módulos destacados -->
        <HBox alignment="CENTER" spacing="36.0">

            <VBox alignment="CENTER" spacing="9.0">
                <VBox alignment="CENTER" prefWidth="62.0" prefHeight="62.0">
                    <FontIcon iconColor="#b7bfae" iconLiteral="fas-chalkboard-teacher" iconSize="25"/>
                </VBox>
                <Label text="Tutores" textFill="#163552"
                       style="-fx-font-size: 11px;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="9.0">
                <VBox alignment="CENTER" prefWidth="62.0" prefHeight="62.0">
                    <FontIcon iconColor="#b7bfae" iconLiteral="fas-user" iconSize="25"/>
                </VBox>
                <Label text="Estudiantes" textFill="#163552"
                       style="-fx-font-size: 11px;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="9.0">
                <VBox alignment="CENTER" prefWidth="62.0" prefHeight="62.0">
                    <FontIcon iconColor="#b7bfae" iconLiteral="fas-history" iconSize="25"/>
                </VBox>
                <Label text="Historial" textFill="#163552"
                       style="-fx-font-size: 11px;"/>
            </VBox>

        </HBox>

    </VBox>

    <!-- ════════════════════════════════════════════════════════
         PANEL DERECHO — formulario (ancho fijo)
         Contiene studentForm y tutorPanel como hermanos;
         solo uno está managed+visible a la vez.
         ════════════════════════════════════════════════════════ -->
    <VBox prefWidth="420.0"
          styleClass="login-right" style="-fx-background-color: #faf8da;
                 -fx-padding: 48 44 36 44;">

        <!-- ── Formulario ESTUDIANTE (visible por defecto) ── -->
        <VBox fx:id="studentForm" alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">

            <VBox alignment="CENTER" spacing="4.0">
                <!-- CORREGIDO: antes era WHITE sobre fondo crema (no se leía) -->
                <Label text="Bienvenido" textFill="#1a4130"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="Inicia sesión para continuar" textFill="#484848"
                       style="-fx-font-size: 13px;"/>
            </VBox>

            <VBox spacing="14.0" maxWidth="Infinity">

                <VBox spacing="5.0">
                    <Label text="CORREO ELECTRÓNICO" textFill="#555555"
                           style="-fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <TextField fx:id="emailField"
                               prefHeight="42.0" maxWidth="Infinity"
                               promptText="usuario@correo.com"
                               style="-fx-font-size: 14px;"/>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="CONTRASEÑA" textFill="#555555"
                           style="-fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="passwordField"
                                   prefHeight="42.0" maxWidth="Infinity"
                                   promptText="••••••••"
                                   style="-fx-font-size: 14px;"/>
                </VBox>

                <Button fx:id="loginButton"
                        maxWidth="Infinity" prefHeight="46.0"
                        onAction="#onLoginButtonClick"
                        styleClass="btn-primary" text="Iniciar Sesión" textFill="WHITE"
                        style="-fx-font-size: 14px; -fx-font-weight: bold;">
                    <graphic>
                        <FontIcon iconColor="white" iconLiteral="fas-sign-in-alt" iconSize="15"/>
                    </graphic>
                </Button>

            </VBox>

            <!-- Footer del formulario estudiante -->
            <VBox alignment="CENTER" spacing="10.0">
                <Button fx:id="btnToggleTutor"
                        mnemonicParsing="false" onAction="#onToggleTutorPanel"
                        text="¿Eres tutor? Acceder como tutor"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #3b7d5c;
                               -fx-font-size: 12px;
                               -fx-cursor: hand;
                               -fx-underline: true;
                               -fx-padding: 0;"/>
                <HBox alignment="CENTER" spacing="6.0">
                    <Label text="¿No tienes cuenta?" textFill="#444444"
                           style="-fx-font-size: 12px;"/>
                    <Button mnemonicParsing="false" onAction="#onGoToRegister"
                            styleClass="btn-default" text="Crear Cuenta"
                            style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

        </VBox>

        <!-- ── Formulario TUTOR (oculto por defecto, reemplaza al anterior) ── -->
        <VBox fx:id="tutorPanel" alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS"
              visible="false" managed="false"
              styleClass="login-right" style="-fx-background-color: #faf8da;">

            <VBox alignment="CENTER" spacing="8.0">
                <FontIcon iconColor="#1a4130" iconLiteral="fas-chalkboard-teacher" iconSize="40"/>
                <Label text="Acceso Tutor" textFill="#1a4130"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="Ingresa tus credenciales y código de acceso" textFill="#2a4a6a"
                       style="-fx-font-size: 12px;"/>
            </VBox>

            <VBox spacing="14.0" maxWidth="Infinity">

                <VBox spacing="5.0">
                    <Label text="CORREO DEL TUTOR" textFill="#2a4a6a"
                           style="-fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <TextField fx:id="tutorEmailField"
                               prefHeight="42.0" maxWidth="Infinity"
                               promptText="tutor@correo.com"
                               style="-fx-font-size: 14px;
                                      -fx-background-color: #ffffff;
                                      -fx-text-fill: #1a4130;
                                      -fx-prompt-text-fill: #7a8f84;
                                      -fx-border-color: #1a4130;
                                      -fx-border-radius: 4;
                                      -fx-background-radius: 4;"/>
                </VBox>

                <VBox spacing="5.0">
                    <Label text="CONTRASEÑA" textFill="#2a4a6a"
                           style="-fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="tutorPasswordField"
                                   prefHeight="42.0" maxWidth="Infinity"
                                   promptText="••••••••"
                                   style="-fx-font-size: 14px;
                                          -fx-background-color: #ffffff;
                                          -fx-text-fill: #1a4130;
                                          -fx-prompt-text-fill: #7a8f84;
                                          -fx-border-color: #1a4130;
                                          -fx-border-radius: 4;
                                          -fx-background-radius: 4;"/>
                </VBox>

                <!-- CORREGIDO: el código de acceso ahora es PasswordField (se oculta con puntos) -->
                <VBox spacing="5.0">
                    <Label text="CÓDIGO DE ACCESO" textFill="#2a4a6a"
                           style="-fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <PasswordField fx:id="tutorTokenField"
                                   prefHeight="42.0" maxWidth="Infinity"
                                   promptText="Proporcionado por administración"
                                   style="-fx-font-size: 14px;
                                          -fx-background-color: #ffffff;
                                          -fx-text-fill: #1a4130;
                                          -fx-prompt-text-fill: #7a8f84;
                                          -fx-border-color: #1a4130;
                                          -fx-border-radius: 4;
                                          -fx-background-radius: 4;"/>
                </VBox>

                <Button fx:id="tutorLoginButton"
                        maxWidth="Infinity" prefHeight="46.0"
                        mnemonicParsing="false" onAction="#onTutorLoginButtonClick"
                        text="Entrar como Tutor"
                        style="-fx-background-color: #1a4130;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-background-radius: 6;">
                    <graphic>
                        <FontIcon iconColor="white" iconLiteral="fas-chalkboard-teacher" iconSize="14"/>
                    </graphic>
                </Button>

            </VBox>

            <Button onAction="#onToggleTutorPanel"
                    text="Volver al inicio de sesión"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #3b7d5c;
                           -fx-font-size: 12px;
                           -fx-cursor: hand;
                           -fx-underline: true;
                           -fx-padding: 0;"/>

        </VBox>

        <!-- Error compartido — visible debajo del formulario activo -->
        <Label fx:id="errorLabel" textFill="#ff5252" visible="false"
               wrapText="true" maxWidth="Infinity"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 0 0 0;"/>

    </VBox>
</HBox>
